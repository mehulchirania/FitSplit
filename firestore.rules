rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/authProfiles/$(request.auth.uid));
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : profile().data.role;
    }

    function currentGymId() {
      return signedIn() && request.auth.token.gymId != null
        ? request.auth.token.gymId
        : profile().data.defaultGymId;
    }

    function memberId() {
      return signedIn() && request.auth.token.memberId != null
        ? request.auth.token.memberId
        : request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isOwnerForGym(gymId) {
      return signedIn()
        && role() == "owner"
        && currentGymId() == gymId;
    }

    // First-class trainer role check.
    function isTrainerForGym(gymId) {
      return signedIn()
        && role() == "trainer"
        && currentGymId() == gymId;
    }

    // Owner or trainer in the same gym.
    function isStaffForGym(gymId) {
      return signedIn()
        && (role() == "owner" || role() == "trainer" || role() == "staff")
        && currentGymId() == gymId;
    }

    function isGymMember(gymId) {
      return signedIn()
        && role() == "member"
        && currentGymId() == gymId;
    }

    function isGymUser(gymId) {
      return isAdmin() || isStaffForGym(gymId) || isGymMember(gymId);
    }

    function isMemberSelf(userId) {
      return signedIn() && role() == "member" && memberId() == userId;
    }

    function profileGym(data) {
      return data.defaultGymId != null ? data.defaultGymId : data.gymId;
    }

    function memberOwned(data) {
      return data.memberId != null && isMemberSelf(data.memberId);
    }

    function ownerScoped(data) {
      return data.gymId != null && isOwnerForGym(data.gymId);
    }

    function adminOrOwnerScoped(data) {
      return isAdmin() || ownerScoped(data);
    }

    function adminOrOwnerOrMemberScoped(data) {
      return adminOrOwnerScoped(data) || memberOwned(data);
    }

    // Trainers can read member data their gym-level visibility setting allows.
    // Visibility enforcement is primarily done server-side; rules provide a
    // coarse baseline: trainer can read any member in their gym.
    // The finer assigned_only / all_pt_members distinction is enforced by
    // server-side queries and callable functions, not rules (rules can't
    // efficiently join across docs without significant read costs).
    function trainerCanReadMember(gymId) {
      return isTrainerForGym(gymId);
    }

    // ─── Gym-scoped collections ───────────────────────────────────────────────

    match /gyms/{gymId} {
      allow read: if isGymUser(gymId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwnerForGym(gymId);

      match /members/{userId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || trainerCanReadMember(gymId)
          || isMemberSelf(userId);
        allow create, delete: if false; // privileged via Functions/Admin SDK
        allow update: if isAdmin()
          || isOwnerForGym(gymId)
          || (
            isMemberSelf(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["age", "heightCm", "weightKg", "goal", "fitnessGoals", "phone", "updatedAt"])
          );
      }

      match /staff/{userId} {
        allow read: if isAdmin()
          || isStaffForGym(gymId)
          || isMemberSelf(userId);
        allow create, update, delete: if false; // privileged via Functions/Admin SDK
      }

      match /exerciseCatalog/{exerciseId} {
        allow read: if isGymUser(gymId);
        allow create, update, delete: if isAdmin() || isOwnerForGym(gymId);
      }

      match /workoutPrograms/{programId} {
        allow read: if isGymUser(gymId);
        allow create, update, delete: if isAdmin() || isOwnerForGym(gymId);
      }

      match /workoutSplitTemplates/{templateId} {
        allow read: if isGymUser(gymId);
        allow create, update, delete: if isAdmin() || isOwnerForGym(gymId);
      }

      match /notifications/{notificationId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || isTrainerForGym(gymId)
          || isMemberSelf(resource.data.recipientUserId)
          || isMemberSelf(resource.data.recipientId);
        allow create: if isAdmin() || isOwnerForGym(gymId);
        allow update: if isAdmin()
          || isOwnerForGym(gymId)
          || (
            (isMemberSelf(resource.data.recipientUserId) || isMemberSelf(resource.data.recipientId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt", "updatedAt"])
          );
        allow delete: if isAdmin() || isOwnerForGym(gymId);
      }

      match /liftLogs/{liftLogId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || trainerCanReadMember(gymId)
          || memberOwned(resource.data);
        allow create: if request.resource.data.gymId == gymId
          && (adminOrOwnerOrMemberScoped(request.resource.data) || isTrainerForGym(gymId));
        allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
      }

      match /macroLogs/{macroLogId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || trainerCanReadMember(gymId)
          || memberOwned(resource.data);
        allow create: if request.resource.data.gymId == gymId
          && adminOrOwnerOrMemberScoped(request.resource.data);
        allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
      }

      match /activityLogs/{activityLogId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || trainerCanReadMember(gymId)
          || memberOwned(resource.data);
        allow create: if request.resource.data.gymId == gymId
          && (adminOrOwnerOrMemberScoped(request.resource.data) || isTrainerForGym(gymId));
        allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data)
          || isTrainerForGym(gymId);
      }

      match /programAssignments/{assignmentId} {
        allow read: if adminOrOwnerOrMemberScoped(resource.data)
          || trainerCanReadMember(gymId);
        allow create, update, delete: if false; // privileged via Functions/Admin SDK
      }

      match /activityEvents/{eventId} {
        allow read: if isAdmin()
          || ownerScoped(resource.data)
          || (resource.data.memberId != null && memberOwned(resource.data))
          || (resource.data.recipientId != null && isMemberSelf(resource.data.recipientId));
        allow create, update, delete: if false; // system-generated by Functions/Admin SDK
      }

      match /workoutSessions/{sessionId} {
        allow read: if adminOrOwnerOrMemberScoped(resource.data) || trainerCanReadMember(gymId);
        allow create: if request.resource.data.gymId == gymId && adminOrOwnerOrMemberScoped(request.resource.data);
        allow update: if adminOrOwnerOrMemberScoped(resource.data)
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.gymId == resource.data.gymId;
        allow delete: if isAdmin() || ownerScoped(resource.data);
      }

      match /attendanceRecords/{attendanceRecordId} {
        allow read: if adminOrOwnerOrMemberScoped(resource.data);
        allow create: if request.resource.data.gymId == gymId && adminOrOwnerOrMemberScoped(request.resource.data);
        allow update, delete: if isAdmin() || ownerScoped(resource.data);
      }

      match /bodyMetricLogs/{bodyMetricLogId} {
        allow read: if adminOrOwnerOrMemberScoped(resource.data) || trainerCanReadMember(gymId);
        allow create: if request.resource.data.gymId == gymId && adminOrOwnerOrMemberScoped(request.resource.data);
        allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
      }

      match /dayLogs/{dayLogId} {
        allow read: if adminOrOwnerOrMemberScoped(resource.data) || trainerCanReadMember(gymId);
        allow create: if request.resource.data.gymId == gymId && adminOrOwnerOrMemberScoped(request.resource.data);
        allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
      }

      match /contactMessages/{messageId} {
        allow create: if true;
        allow read, update, delete: if isAdmin() || isStaffForGym(gymId);
      }

      match /siteLinks/{linkId} {
        allow read: if true;
        allow write: if isAdmin() || isOwnerForGym(gymId);
      }

      match /exerciseRequests/{requestId} {
        allow read: if isGymUser(gymId);
        allow create: if isGymUser(gymId);
        allow update, delete: if isAdmin() || isOwnerForGym(gymId);
      }

      // PT sessions — any gym staff can read/write (cover trainer support).
      // Members can read their own sessions.
      match /ptSessions/{ptSessionId} {
        allow read: if isAdmin()
          || isStaffForGym(gymId)
          || (isGymMember(gymId) && resource.data.memberId == memberId());
        allow create: if isAdmin() || isStaffForGym(gymId);
        allow update: if isAdmin() || isStaffForGym(gymId);
        allow delete: if isAdmin() || isOwnerForGym(gymId);
      }

      match /ptLiftLogs/{ptLiftLogId} {
        allow read: if isAdmin()
          || isStaffForGym(gymId)
          || (isGymMember(gymId) && resource.data.memberId == memberId());
        allow create: if isAdmin() || isStaffForGym(gymId);
        allow update, delete: if isAdmin() || isStaffForGym(gymId);
      }

      // ── Billing collections — trainers have NO access ──────────────────────

      // Membership package definitions — owner creates, members can read their gym's packages.
      match /packages/{packageId} {
        allow read: if isAdmin() || isOwnerForGym(gymId) || isGymMember(gymId);
        allow create, update, delete: if isAdmin() || isOwnerForGym(gymId);
        // Trainers: no access to billing/packages.
      }

      // Per-member membership records — owner and member-self only.
      match /memberships/{membershipId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || (isGymMember(gymId) && resource.data.memberId == memberId());
        allow create, update, delete: if false; // privileged via Functions/Admin SDK
        // Trainers: no access.
      }

      // Payment requests — owner and member-self only.
      match /paymentRequests/{requestId} {
        allow read: if isAdmin()
          || isOwnerForGym(gymId)
          || (isGymMember(gymId) && resource.data.memberId == memberId());
        allow create: if isAdmin()
          || isOwnerForGym(gymId)
          || (isGymMember(gymId) && request.resource.data.memberId == memberId());
        allow update, delete: if false; // approval/rejection go through Functions
        // Trainers: no access.
      }

      // Pre-computed dashboard summary — read by owner, written by Functions.
      match /summaries/{summaryId} {
        allow read: if isAdmin() || isOwnerForGym(gymId);
        allow write: if false; // written exclusively by Admin SDK / Functions
      }
    }

    // ─── Root-level collections ───────────────────────────────────────────────

    match /authProfiles/{userId} {
      allow read: if isAdmin()
        || isOwnerForGym(profileGym(resource.data))
        || isTrainerForGym(profileGym(resource.data))
        || isMemberSelf(userId);
      allow create, delete: if isAdmin()
        || (request.resource.data.role == "member" && isOwnerForGym(profileGym(request.resource.data)));
      allow update: if isAdmin()
        || isOwnerForGym(profileGym(resource.data))
        || (
          isMemberSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["age", "heightCm", "weightKg", "goal", "fitnessGoals", "phone", "medicalNotes", "primarySlot", "secondarySlot", "updatedAt"])
        );
    }

    match /profiles/{userId} {
      allow read: if isAdmin()
        || isOwnerForGym(profileGym(resource.data))
        || isMemberSelf(userId);
      allow create, update, delete: if false;
    }

    match /exerciseCatalog/{exerciseId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workoutPrograms/{programId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workoutSplitTemplates/{templateId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || ownerScoped(resource.data)
        || isMemberSelf(resource.data.recipientUserId)
        || isMemberSelf(resource.data.recipientId);
      allow create: if adminOrOwnerScoped(request.resource.data);
      allow update: if isAdmin()
        || ownerScoped(resource.data)
        || (
          (isMemberSelf(resource.data.recipientUserId) || isMemberSelf(resource.data.recipientId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt", "updatedAt"])
        );
      allow delete: if isAdmin();
    }

    match /liftLogs/{liftLogId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
    }

    // Root mirror of macroLogs (dual-write). Scoped like liftLogs; written via Admin SDK.
    match /macroLogs/{macroLogId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
    }

    // Root mirror of activityLogs (dual-write). Scoped like liftLogs; written via Admin SDK.
    match /activityLogs/{activityLogId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
    }

    // Root mirror of per-member membership records. Owner and member-self read;
    // writes are privileged (Functions/Admin SDK) — mirrors the gym-scoped rule.
    match /memberships/{membershipId} {
      allow read: if isAdmin()
        || ownerScoped(resource.data)
        || (isGymMember(resource.data.gymId) && resource.data.memberId == memberId());
      allow create, update, delete: if false;
    }

    match /programAssignments/{assignmentId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /activityEvents/{eventId} {
      allow read: if isAdmin()
        || ownerScoped(resource.data)
        || (resource.data.memberId != null && memberOwned(resource.data))
        || (resource.data.recipientId != null && isMemberSelf(resource.data.recipientId));
      allow create, update, delete: if false;
    }

    match /workoutSessions/{sessionId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update: if adminOrOwnerOrMemberScoped(resource.data)
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdmin() || ownerScoped(resource.data);
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || ownerScoped(resource.data);
    }

    match /attendanceRecords/{attendanceRecordId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data);
    }

    match /siteLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bodyMetricLogs/{bodyMetricLogId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
    }

    match /dayLogs/{dayLogId} {
      allow read: if adminOrOwnerOrMemberScoped(resource.data);
      allow create: if adminOrOwnerOrMemberScoped(request.resource.data);
      allow update, delete: if isAdmin() || ownerScoped(resource.data) || memberOwned(resource.data);
    }

    match /exerciseRequests/{requestId} {
      // Gym-scoped: only users of the request's own gym may read/create it.
      // (Previously `signedIn()`, which leaked requests across tenants.)
      allow read: if isGymUser(resource.data.gymId);
      allow create: if isGymUser(request.resource.data.gymId);
      allow update, delete: if isAdmin() || ownerScoped(resource.data);
    }

    match /ptSessions/{ptSessionId} {
      allow read: if isAdmin()
        || (signedIn() && (role() == "owner" || role() == "trainer")
            && currentGymId() == resource.data.gymId)
        || (signedIn() && role() == "member" && resource.data.memberId == memberId());
      allow write: if isAdmin()
        || (signedIn() && (role() == "owner" || role() == "trainer")
            && currentGymId() == resource.data.gymId);
    }

    match /ptLiftLogs/{ptLiftLogId} {
      allow read: if isAdmin()
        || (signedIn() && (role() == "owner" || role() == "trainer")
            && currentGymId() == resource.data.gymId)
        || (signedIn() && role() == "member" && resource.data.memberId == memberId());
      allow write: if isAdmin()
        || (signedIn() && (role() == "owner" || role() == "trainer")
            && currentGymId() == resource.data.gymId);
    }

    // Admin SDK only — explicit deny for documentation.
    match /loginAttempts/{id} {
      allow read, write: if false;
    }

    match /usernames/{id} {
      allow read, write: if false;
    }

    // Admin-only platform summary.
    match /platformSummaries/{id} {
      allow read: if isAdmin();
      allow write: if false; // written exclusively by Admin SDK / Functions
    }

    match /archives/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
