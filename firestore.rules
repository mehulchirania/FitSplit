rules_version = '2';

// FitSplit stores everything a user owns under users/{uid}. The web app talks to
// Firestore only through server actions (Admin SDK, which bypasses these rules),
// so clients never write directly. Rules exist as a safety net: a signed-in user
// may read their own data and nothing else; every write and every other path is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
