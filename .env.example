# --- Local development without Firebase -------------------------------------
# Set this to run the whole app with no Firebase at all (accounts are fake and
# nothing is persisted). Ignored in production builds.
# FITSPLIT_LOCAL_MODE=true

# --- Firebase (real project) -------------------------------------------------
# Public web config; NEXT_PUBLIC_FIREBASE_API_KEY is also used server-side for
# email/password sign-in via the Identity Toolkit REST API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
FIREBASE_PROJECT_ID=
# Recommended for local server actions: path to a downloaded Firebase service account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative to GOOGLE_APPLICATION_CREDENTIALS: paste service account fields directly.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Sentry error monitoring (optional) -------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
