{
  "name": "fitsplit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "deploy:firebase": "npm run build && firebase deploy",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "npm --prefix functions run build && firebase deploy --only functions",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:build:apk": "npm --prefix mobile run build:apk",
    "mobile:build:aab": "npm --prefix mobile run build:aab",
    "mobile:build:ios": "npm --prefix mobile run build:ios",
    "seed:gyms": "node scripts/seed-clean-gyms.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node --experimental-vm-modules scripts/test-firestore-rules.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@fitsplit/core": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.2",
    "dexie": "^4.4.4",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.42.0",
    "next": "^16.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.50.0",
    "@sentry/nextjs": "^10.69.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "knip": "^6.25.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.16"
  }
}
