{
  "name": "fitsplit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "knip": "knip",
    "deploy:firebase": "npm run build && firebase deploy",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "npm --prefix functions run build && firebase deploy --only functions",
    "seed:billing": "node scripts/seed-billing.mjs",
    "seed:auth": "node scripts/seed-firebase-auth.mjs",
    "seed:firebase": "node scripts/seed-firebase.mjs",
    "seed:demo": "node scripts/seed-demo-firestore.mjs",
    "migrate:gym-scoped": "node scripts/migrate-gym-scoped-firestore.mjs",
    "migrate:tenant-cleanup": "node scripts/migrate-auth-profiles-and-clean-root.mjs",
    "backfill:member-access": "node scripts/backfill-member-access.mjs",
    "patch:videos": "node scripts/patch-exercise-videos.mjs",
    "sync:exercise-videos": "node scripts/sync-exercise-videos-from-workouts.mjs",
    "fetch:channel-videos": "node scripts/fetch-channel-videos.mjs",
    "fix:gym-video-urls": "node scripts/fix-gym-scoped-video-urls.mjs",
    "fix:exercises": "node scripts/fix-exercise-catalog.mjs",
    "split:css": "node scripts/split-css.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node --experimental-vm-modules scripts/test-firestore-rules.mjs",
    "migrate:phase1": "node scripts/migrate-phase1.mjs",
    "migrate:phase1:commit": "node scripts/migrate-phase1.mjs --commit",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "dexie": "^4.4.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.40.0",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@next/bundle-analyzer": "^16.2.7",
    "@sentry/nextjs": "^9.47.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^15.3.1",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
