{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["firebase"],
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/{page,layout,template,loading,error,not-found,route,default}.{ts,tsx}",
        "scripts/**/*.{js,mjs}",
        "e2e/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": ["@opentelemetry/*", "postcss"]
    },
    "packages/core": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "mobile": {}
  }
}
