# Copy to .env.local and set NEXT_PUBLIC_USE_EMULATOR=true to use local Firebase emulators.
# Start emulators with: firebase emulators:start
# Then run: npm run dev

NEXT_PUBLIC_USE_EMULATOR=true

NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fitsplit
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-fitsplit.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
