# Run against the local Firebase emulators instead of a real project.
# Start them with: firebase emulators:start   (Auth :9099, Firestore :8080, Storage :9199)
# Then copy these values into .env.local and run: npm run dev
FIREBASE_PROJECT_ID=demo-fitsplit
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fitsplit
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-fitsplit.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
