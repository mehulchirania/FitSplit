rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /gyms/{gymId}/exercise-videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /gyms/{gymId}/exercise-thumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
