rules_version = '2';

// Profile photos are uploaded by the server (Admin SDK, which bypasses these rules)
// and served through tokenised download URLs. Clients never read or write the
// bucket directly, so every path is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
